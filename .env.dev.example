# Ambiente DEV (desenvolvimento, no seu PC). Copie para ".env.dev" e troque as senhas.
#   PowerShell: .\scripts\ambiente.ps1 dev up
#   Git Bash:   bash scripts/ambiente.sh dev up
APP_ENV=dev
COMPOSE_PROJECT_NAME=rachaai-dev
# Liga o Mailpit (caixa de e-mail de teste)
COMPOSE_PROFILES=mail-teste

# --- Portas no seu PC (não podem repetir entre ambientes que rodam juntos) ---
# 8081 costuma estar ocupada pelo Eclipse; por isso o site de dev fica na 8082.
SITE_PORT=8082
API_PORT=8080
DB_PORT=1522
MAIL_UI_PORT=8025

# --- Banco ---
# Senhas: só letras e números, começando por letra (o Oracle recusa símbolos).
ORACLE_PASSWORD=TroqueEstaSenhaAdmin1
DB_USER=rachaai
DB_PASSWORD=TroqueEstaSenha1

# --- Segurança ---
# String em Base64. Gere com: openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWNoYW5nZS1tZS1pbi1wcm9kdWN0aW9uLTEyMzQ1Njc4OTA=
JWT_EXPIRATION_MINUTES=1440

# --- Endereços (precisam bater com SITE_PORT) ---
# 5173 = "npm run dev" do frontend, para desenvolver fora do Docker.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8082
APP_BASE_URL=http://localhost:8082

# --- E-mail: vai para o Mailpit (http://localhost:8025), não sai para a internet ---
MAIL_HOST=mailpit
MAIL_PORT=1025

# --- Cobrança: SIMULADO = botão "Simular pagamento", não cobra ninguém ---
BILLING_MODE=SIMULADO
FREE_LISTINGS=3
EXTRA_LISTING_PRICE=19.90
EXTRA_LISTING_DAYS=30
HIGHLIGHT_PRICE=14.90
HIGHLIGHT_DAYS=30
EXPIRATION_CHECK=PT10M

# --- Administração ---
# E-mails das contas que podem abrir a área /admin (separados por vírgula). A conta precisa
# existir; o backend marca como admin ao subir. O "seed" cria admin@teste.com (senha senha123).
ADMIN_EMAILS=admin@teste.com
