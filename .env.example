# Copie este arquivo para ".env" antes de rodar docker compose.

# REGRA das duas senhas abaixo (ORACLE_PASSWORD e DB_PASSWORD): somente letras e números,
# começando por letra. Sem hífen, espaço ou símbolos (o Oracle pode recusar o login).

# Senha do SYS/SYSTEM do Oracle XE (só para administração do banco).
ORACLE_PASSWORD=TroqueEstaSenhaAdmin1

# Usuário/schema da aplicação (criado automaticamente pelo container Oracle).
DB_USER=rachaai
DB_PASSWORD=TroqueEstaSenha1

# Precisa ser uma string em Base64. Gere uma nova com:
#   openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWNoYW5nZS1tZS1pbi1wcm9kdWN0aW9uLTEyMzQ1Njc4OTA=
JWT_EXPIRATION_MINUTES=1440

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- E-mail (esqueci minha senha) ---
# Por padrao usa o Mailpit do docker compose: os e-mails NAO saem para a internet, ficam na
# caixa de teste em http://localhost:8025. Para receber e-mail de verdade, preencha (exemplo Gmail;
# em MAIL_PASSWORD vai a "senha de app" de 16 letras, criada em myaccount.google.com/apppasswords):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=seuemail@gmail.com
# MAIL_PASSWORD=senha-de-app
# MAIL_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=RachaAi <seuemail@gmail.com>
# Endereco publico do site, usado no link do e-mail (troque ao publicar, ex.: https://meusite.com)
APP_BASE_URL=http://localhost:8081

# --- Cobranca (opcional; estes sao os valores padrao) ---
# SIMULADO = o botao "Simular pagamento" confirma compras sem cobrar. Nao use com usuarios reais.
BILLING_MODE=SIMULADO
FREE_LISTINGS=3
EXTRA_LISTING_PRICE=19.90
EXTRA_LISTING_DAYS=30
HIGHLIGHT_PRICE=14.90
HIGHLIGHT_DAYS=30
# De quanto em quanto tempo anuncios extras vencidos sao desativados (formato ISO-8601: PT10M = 10 minutos)
EXPIRATION_CHECK=PT10M

