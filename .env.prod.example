# Ambiente PROD (produção, com usuários reais). Feito para rodar num SERVIDOR, não no PC de
# desenvolvimento. Copie para ".env.prod" no servidor e preencha tudo; nunca faça commit dele.
#   PowerShell: .\scripts\ambiente.ps1 prod up
#   Git Bash:   bash scripts/ambiente.sh prod up
APP_ENV=prod
COMPOSE_PROJECT_NAME=rachaai-prod
# Sem COMPOSE_PROFILES: o Mailpit não sobe em produção.

# --- Portas ---
# Só o site fica aberto. API e banco ficam fechados pelo docker-compose.prod.yml; os dois valores
# abaixo são exigidos pelo arquivo base, mas em prod não abrem porta nenhuma.
SITE_PORT=80
API_PORT=18080
DB_PORT=11521

# --- Banco (só letras e números, começando por letra; use senhas longas) ---
ORACLE_PASSWORD=
DB_USER=rachaai
DB_PASSWORD=

# --- Segurança: OBRIGATÓRIO gerar um novo (openssl rand -base64 48) ---
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# --- Endereço público do site (com https quando tiver domínio) ---
CORS_ALLOWED_ORIGINS=https://seudominio.com.br
APP_BASE_URL=https://seudominio.com.br

# --- E-mail real (SMTP). Exemplo Gmail com "senha de app" ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=RachaAi <seuemail@gmail.com>

# --- Cobrança ---
# MERCADOPAGO = cobrança real pelo Mercado Pago. Preços abaixo são de TESTE: definir os reais.
BILLING_MODE=MERCADOPAGO
FREE_LISTINGS=3
EXTRA_LISTING_PRICE=1.00
EXTRA_LISTING_DAYS=30
HIGHLIGHT_PRICE=1.00
HIGHLIGHT_DAYS=30
EXPIRATION_CHECK=PT10M

# --- Administração ---
# E-mails das contas que podem abrir a área /admin (separados por vírgula). Cadastre a conta
# normalmente pelo site e depois reinicie o backend para ela virar admin.
ADMIN_EMAILS=

# --- Mapas e busca de endereço (MapTiler) ---
# Chave em https://cloud.maptiler.com/account/keys/ . Vazia = OpenStreetMap gratuito (só para
# desenvolver). A chave vai para o navegador: no painel do MapTiler, em "Allowed HTTP origins",
# libere só os endereços deste ambiente (ex.: seudominio.com.br).
MAPTILER_KEY=

# --- Mercado Pago (pagamento com Pix, crédito e débito) ---
# Credencial de PRODUÇÃO (começa com APP_USR-): cobra de verdade.
MERCADOPAGO_ACCESS_TOKEN=
# Suas integrações → Webhooks: a "assinatura secreta" e a URL de notificação do site:
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=https://seudominio.com.br/api/billing/webhook/mercadopago
