# Ambiente HOMOLOG (homologação: onde se testa antes de ir para produção).
# Copie para ".env.homolog" e troque TODAS as senhas (não reaproveite as de dev).
#   PowerShell: .\scripts\ambiente.ps1 homolog up
#   Git Bash:   bash scripts/ambiente.sh homolog up
APP_ENV=homolog
COMPOSE_PROJECT_NAME=rachaai-homolog
COMPOSE_PROFILES=mail-teste

# --- Portas: diferentes das de dev, para os dois poderem rodar ao mesmo tempo ---
SITE_PORT=8092
API_PORT=8090
DB_PORT=1532
MAIL_UI_PORT=8035

# --- Banco (só letras e números, começando por letra) ---
ORACLE_PASSWORD=TroqueSenhaAdminQa1
DB_USER=rachaai
DB_PASSWORD=TroqueSenhaQa1

# --- Segurança: gere um novo com openssl rand -base64 48 ---
JWT_SECRET=TROQUE-gere-com-openssl-rand-base64-48
JWT_EXPIRATION_MINUTES=1440

# --- Endereços (se o homolog for para um servidor, troque pelo endereço dele) ---
CORS_ALLOWED_ORIGINS=http://localhost:8092
APP_BASE_URL=http://localhost:8092

# --- E-mail: Mailpit do homolog (http://localhost:8035) ---
MAIL_HOST=mailpit
MAIL_PORT=1025

# --- Cobrança: simulada, para testar compra de anúncio extra e destaque ---
BILLING_MODE=SIMULADO
FREE_LISTINGS=3
EXTRA_LISTING_PRICE=19.90
EXTRA_LISTING_DAYS=30
HIGHLIGHT_PRICE=14.90
HIGHLIGHT_DAYS=30
EXPIRATION_CHECK=PT10M

# --- Administração ---
# E-mails das contas que podem abrir a área /admin (separados por vírgula). A conta precisa
# existir; o backend marca como admin ao subir. O "seed" cria admin@teste.com (senha senha123).
ADMIN_EMAILS=admin@teste.com
