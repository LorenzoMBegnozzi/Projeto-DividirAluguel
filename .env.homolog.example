# Ambiente HOMOLOG (homologação: onde se testa antes de ir para produção).
# Copie para ".env.homolog" e troque TODAS as senhas (não reaproveite as de dev).
#   PowerShell: .\scripts\ambiente.ps1 homolog up
#   Git Bash:   bash scripts/ambiente.sh homolog up
APP_ENV=homolog
COMPOSE_PROJECT_NAME=rachaai-homolog
COMPOSE_PROFILES=mail-teste

# --- Portas: diferentes das de dev, para os dois poderem rodar ao mesmo tempo ---
SITE_PORT=8092
API_PORT=8090
DB_PORT=1532
MAIL_UI_PORT=8035

# --- Banco (Postgres) ---
POSTGRES_ADMIN_PASSWORD=TroqueSenhaAdminQa1
DB_USER=rachaai
DB_PASSWORD=TroqueSenhaQa1

# --- Segurança: gere um novo com openssl rand -base64 48 ---
JWT_SECRET=TROQUE-gere-com-openssl-rand-base64-48
JWT_EXPIRATION_MINUTES=1440

# --- Endereços (no servidor: https://homolog.toctocwho.com.br nos dois) ---
CORS_ALLOWED_ORIGINS=http://localhost:8092
APP_BASE_URL=http://localhost:8092

# --- E-mail: Mailpit do homolog (http://localhost:8035; no servidor, pelo túnel SSH: deploy/README.md) ---
MAIL_HOST=mailpit
MAIL_PORT=1025

# --- Cobrança: simulada, para testar compra de anúncio extra e destaque ---
BILLING_MODE=SIMULADO
FREE_LISTINGS=2
EXTRA_LISTING_PRICE=1.00
EXTRA_LISTING_DAYS=30
HIGHLIGHT_PRICE=1.00
HIGHLIGHT_DAYS=30
EXPIRATION_CHECK=PT10M

# --- Administração ---
# E-mails das contas que podem abrir a área /admin (separados por vírgula). A conta precisa
# existir; o backend marca como admin ao subir. O "seed" cria admin@teste.com (senha senha123).
ADMIN_EMAILS=admin@teste.com

# --- Mapas e busca de endereço (MapTiler) ---
# Chave em https://cloud.maptiler.com/account/keys/ . Vazia = OpenStreetMap gratuito (só para
# desenvolver). A chave vai para o navegador: no painel do MapTiler, em "Allowed HTTP origins",
# libere só os endereços deste ambiente (ex.: localhost:8082).
MAPTILER_KEY=

# --- Mercado Pago (pagamento com Pix, crédito e débito) ---
# Para cobrar pelo Mercado Pago: BILLING_MODE=MERCADOPAGO e o Access Token abaixo.
# Use a credencial de TESTE (começa com TEST-): não cobra ninguém. Pegue em
# mercadopago.com.br → Suas integrações → sua aplicação → Credenciais de teste.
MERCADOPAGO_ACCESS_TOKEN=
# Opcionais (precisam de domínio público com HTTPS; em dev ficam vazios):
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=

# Login com Google: Client ID do Google Cloud Console (Credenciais > ID do cliente OAuth,
# tipo "Aplicativo da Web"), com este endereço do site nas "Origens JavaScript autorizadas".
# Não é segredo (o site mostra no botão). Vazio = botão do Google escondido.
GOOGLE_CLIENT_ID=

# --- Servidor (VPS): versão das imagens geradas pelo GitHub Actions (.github/workflows/imagens.yml) ---
# main = a mais nova; sha-xxxxxxx = uma versão fixa. "bash deploy/servidor.sh homolog subir <versão>"
# troca este valor sozinho. Só é usado no servidor (deploy/README.md).
IMAGE_TAG=main
